<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\TeachingAssistant.Domain\TeachingAssistant.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="TeachingAssistant.Tests" />
    </ItemGroup>

    <ItemGroup>
      <!-- The model's fixed instructions, read by Prompts/PromptLibrary.cs -->
      <EmbeddedResource Include="Prompts\*.md" LogicalName="TeachingAssistant.Application.Prompts.%(Filename)%(Extension)" />
      <!-- The teacher's short Checkstyle rule list, sent into the sandbox by Services/JavaBuildCheck.cs -->
      <EmbeddedResource Include="Checks\checkstyle.xml" LogicalName="TeachingAssistant.Application.Checks.checkstyle.xml" />
      <EmbeddedResource Include="Checks\pmd.xml" LogicalName="TeachingAssistant.Application.Checks.pmd.xml" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- XML doc comments on contracts flow into the API's OpenAPI document -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

</Project>
