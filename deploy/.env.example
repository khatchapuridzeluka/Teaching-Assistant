# Copy to deploy/.env on the VM (git-ignored) and fill in every value.

# The domain pointing at the VM; Caddy gets its HTTPS certificate for it, and Google redirects to
# https://<DOMAIN>/api/auth/google/callback, which must be registered on the Web application OAuth client.
DOMAIN=ta.example.com

# Group id of the docker group on the VM, so the API can start sandboxes: getent group docker | cut -d: -f3
DOCKER_GID=999

POSTGRES_PASSWORD=choose-a-long-random-password

ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=
