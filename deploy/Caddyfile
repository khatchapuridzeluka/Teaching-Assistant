{$SITE_ADDRESS} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:app:8080}
	}

	handle {
		root * /srv/frontend
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
